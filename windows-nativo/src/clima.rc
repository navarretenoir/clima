/* Recursos de Clima para Windows — desarrollado por Javiera Navarrete */
#include <windows.h>
#include "recursos.h"

IDI_CLIMA   ICON    "clima.ico"
IDR_COMUNAS RCDATA  "comunas.txt"

#ifdef UNICODE
/* manifiesto: controles comunes modernos, sin virtualización de PPP borrosa, compatible Vista→11 (2000/XP lo ignoran) */
1 24 "clima.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,2,0
 PRODUCTVERSION  1,0,2,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS__WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "340A04B0"
    BEGIN
      VALUE "CompanyName",      "Javiera Navarrete"
      VALUE "FileDescription",  "Clima - el tiempo para las comunas de Chile"
      VALUE "FileVersion",      "1.0.2"
      VALUE "InternalName",     "Clima"
      VALUE "LegalCopyright",   "(c) 2026 Javiera Navarrete"
      VALUE "OriginalFilename", "Clima.exe"
      VALUE "ProductName",      "Clima"
      VALUE "ProductVersion",   "1.0.2"
      VALUE "Comments",         "Desarrollado por Javiera Navarrete. Datos: Open-Meteo."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x340A, 1200
  END
END
